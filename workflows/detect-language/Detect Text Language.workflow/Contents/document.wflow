				<dict>
					<key>COMMAND_STRING</key>
					<string>set -u
WFLOW_NAME="Detect Text Language.workflow"
BIN_NAME="DetectLanguage"
TITLE="Detect Text Language"

find_helper() {
    local p="$HOME/Library/Services/$WFLOW_NAME/Contents/Resources/$BIN_NAME"
    [ -x "$p" ] &amp;&amp; { printf '%s' "$p"; return 0; }
    p="$(mdfind "kMDItemFSName == '$WFLOW_NAME'" 2&gt;/dev/null | head -1)"
    p="$p/Contents/Resources/$BIN_NAME"
    [ -x "$p" ] &amp;&amp; { printf '%s' "$p"; return 0; }
    return 1
}

BIN="$(find_helper)" || {
    osascript -e "display dialog \"$TITLE needs its on-device helper, which has not been built yet.\n\nIn Terminal, change to this action's folder and run:\n    ./build.sh\n\nThen double-click the .workflow file to install it again.\" buttons {\"OK\"} default button \"OK\" with title \"$TITLE\""
    exit 1
}

if ! RESULT="$(cat | "$BIN" 2&gt;/dev/null)"; then exit 1; fi
[ -z "$RESULT" ] &amp;&amp; exit 0
osascript -e "display notification \"$RESULT\" with title \"$TITLE\""
</string>
