				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>COUNT=0
for f in "$@"; do
  D=$(dirname "$f")
  B=$(basename "$f")
  STEM="$B"
  case "$B" in
    ?*.*) STEM="${B%.*}" ;;
  esac
  DEST="$D/$STEM.zip"
  i=2
  while [ -e "$DEST" ]; do DEST="$D/$STEM $i.zip"; i=$((i + 1)); done
  if ( cd "$D" &amp;&amp; zip -qr -X "$DEST" "$B" -x '*.DS_Store' '__MACOSX/*' ); then
    COUNT=$((COUNT + 1))
  fi
done
osascript -e "display notification \"$COUNT archive(s) created\" with title \"Zip Clean\""</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
