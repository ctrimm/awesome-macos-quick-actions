				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>if [ "$#" -eq 2 ]; then
  TARGET=""
  CHECK=""
  for f in "$@"; do
    case "$f" in
      *.sha256) CHECK="$f" ;;
      *) TARGET="$f" ;;
    esac
  done
  if [ -n "$CHECK" ] &amp;&amp; [ -n "$TARGET" ]; then
    EXPECTED=$(grep -oE '[0-9a-fA-F]{64}' "$CHECK" | head -n 1 | tr 'A-F' 'a-f')
    ACTUAL=$(shasum -a 256 "$TARGET" | awk '{print $1}')
    if [ -n "$EXPECTED" ] &amp;&amp; [ "$EXPECTED" = "$ACTUAL" ]; then
      osascript -e 'display notification "Checksum MATCHES - file verified" with title "Checksum SHA-256"'
    else
      osascript -e 'display notification "Checksum MISMATCH - file may be corrupt" with title "Checksum SHA-256"'
    fi
    exit 0
  fi
fi
for f in "$@"; do shasum -a 256 "$f"; done | pbcopy
osascript -e 'display notification "SHA-256 checksum(s) copied" with title "Checksum SHA-256"' </string>
					<key>CheckedForUserDefaultShell</key>
