					<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
/usr/bin/python3 - "$@" &lt;&lt;'PYEOF'
import os, sys, subprocess
from Foundation import NSURL
from Quartz import PDFDocument

pdfs = [p for p in sys.argv[1:] if os.path.isfile(p) and p.lower().endswith('.pdf')]
if not pdfs:
    subprocess.run(['osascript', '-e', 'display dialog "Select one or more PDF files." buttons {"OK"} default button "OK" with title "Split PDF"'])
    sys.exit(0)

count = 0
for p in pdfs:
    src = PDFDocument.alloc().initWithURL_(NSURL.fileURLWithPath_(p))
    if src is None:
        continue
    d = os.path.dirname(p)
    base = os.path.basename(p)
    name = base[:-4] if base.lower().endswith('.pdf') else base
    for i in range(src.pageCount()):
        one = PDFDocument.alloc().init()
        one.insertPage_atIndex_(src.pageAtIndex_(i), 0)
        out = os.path.join(d, '%s-p%03d.pdf' % (name, i + 1))
        if one.writeToFile_(out):
            count += 1
subprocess.run(['osascript', '-e', 'display notification "Wrote %d single-page PDFs." with title "Split PDF"' % count])
PYEOF</string>
