					<string>export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
/usr/bin/python3 - "$@" &lt;&lt;'PYEOF'
import os, sys, subprocess
from AppKit import NSImage
from Quartz import PDFDocument, PDFPage

IMG = ('.jpg', '.jpeg', '.png', '.gif', '.bmp', '.tiff', '.tif', '.heic', '.webp')
files = [p for p in sys.argv[1:] if os.path.isfile(p) and p.lower().endswith(IMG)]
if not files:
    subprocess.run(['osascript', '-e', 'display dialog "Select one or more image files." buttons {"OK"} default button "OK" with title "Combine Images into PDF"'])
    sys.exit(0)

doc = PDFDocument.alloc().init()
for p in sorted(files):
    img = NSImage.alloc().initWithContentsOfFile_(p)
    if img is None:
        continue
    page = PDFPage.alloc().initWithImage_(img)
    if page is not None:
        doc.insertPage_atIndex_(page, doc.pageCount())

d = os.path.dirname(files[0])
out = os.path.join(d, 'images.pdf')
n = 2
while os.path.exists(out):
    out = os.path.join(d, 'images-%d.pdf' % n)
    n += 1
if doc.writeToFile_(out):
    subprocess.run(['osascript', '-e', 'display notification "Combined %d images into PDF." with title "Combine Images into PDF"' % len(files)])
